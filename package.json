{
  "name": "girici-web-proxy",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "description": "A web proxy for unblocking websites",
  "author": "Halit Sever",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "node packages/server/dist/index.js",
    "dev": "run-p --print-label \"dev:*\"",
    "dev:server": "npm run dev -w @girici/server",
    "dev:web": "npm run dev -w @girici/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "test": "npm run build:lib -w @girici/engine && vitest run",
    "lint": "eslint . --max-warnings=0",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run build -w @girici/engine && npm run build -w @girici/web && playwright test",
    "test:smoke": "SMOKE=1 npm run test:e2e -- --project=chromium smoke",
    "dev:engine": "npm run dev -w @girici/engine"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "selfsigned": "^5.5.0",
    "typescript": "~6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  }
}
