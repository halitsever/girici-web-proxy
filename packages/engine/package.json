{
  "name": "@girici/engine",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./shared": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "build:lib": "tsc -p tsconfig.lib.json",
    "build": "npm run build:lib && node scripts/build.mjs",
    "dev": "run-p --print-label \"dev:*\"",
    "dev:lib": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput",
    "dev:bundles": "node scripts/build.mjs --watch",
    "typecheck": "npm run build:lib && tsc -p tsconfig.sw.json && tsc -p tsconfig.boot.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "htmlparser2": "^12.0.0",
    "magic-string": "^1.4.5",
    "meriyah": "^7.4.1",
    "tldts": "^7.4.19"
  }
}
