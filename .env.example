# Copy to .env next to docker-compose.yml; docker compose reads it on its own.
# Every other setting is listed in docs/guide/configuration.md; add those under `environment:` in the compose file.

# Your domain, for the https profile: docker compose --profile https up -d
GIRICI_DOMAIN=

# Number of proxies in front of Girici. Set 1 with the https or sites profile so rate limits see each visitor.
GIRICI_TRUST_PROXY=

# A fixed setup code (8 or more characters) instead of the random one printed to the log at startup.
# Make one with: openssl rand -hex 16
GIRICI_SETUP_TOKEN=

# Open-instance limits, all off until set. Sizes such as 500MB or 2GB.
# GIRICI_BANDWIDTH_LIMIT=50MB
# GIRICI_DAILY_QUOTA=2GB
# Turns on /metrics for Prometheus; 16 or more characters. Make one with: openssl rand -hex 32
# GIRICI_METRICS_TOKEN=
# How hard the browser check is, 1 to 24 (default 16). The check itself is switched on in Settings.
# GIRICI_POW_DIFFICULTY=16

# Subdomain mode: each site gets its own host under this domain (leave off :443). See docs/guide/subdomain-mode.md.
GIRICI_SITE_DOMAIN=

# Optional secret behind the site host names, 32+ characters (openssl rand -hex 32). Replicas share it; never change it.
GIRICI_SITE_SECRET=

# Cloudflare API token with Zone.Zone:Read and Zone.DNS:Edit, so the sites profile gets its wildcard certificate.
CLOUDFLARE_API_TOKEN=

# Caddy DNS module for another DNS provider, such as github.com/caddy-dns/digitalocean@master.
CADDY_DNS_MODULE=
